# Copy to .env and fill in. .env is ignored by Git. Never commit real values.
# Every setting can also be supplied as a real environment variable.

# --- Required: where and how to sign in -------------------------------------
# Address of the Dataverse environment: https and host only, no path.
DATAVERSE_URL=https://your-environment.example.com
# Microsoft Entra tenant ID (GUID) or tenant domain.
DATAVERSE_TENANT_ID=00000000-0000-0000-0000-000000000000
# Application (client) ID of the app registration.
DATAVERSE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Set exactly one credential. A certificate is preferred over a secret.
DATAVERSE_CLIENT_SECRET=
# DATAVERSE_CLIENT_CERTIFICATE_PATH=/path/to/private-key.pem
# DATAVERSE_CLIENT_CERTIFICATE_THUMBPRINT=

# --- Optional: Microsoft cloud ----------------------------------------------
# Sign-in address. Commercial and GCC use the default.
# GCC High and DoD use https://login.microsoftonline.us
# DATAVERSE_AUTHORITY_HOST=https://login.microsoftonline.com
# DATAVERSE_API_VERSION=v9.2

# --- Optional: logging -------------------------------------------------------
# DATAVERSE_LOG_LEVEL=INFO

# --- What the agent may use --------------------------------------------------
# Comma-separated IDs of the system views the data owner has approved.
# Only these views can be listed, described, counted, or read.
DATAVERSE_APPROVED_VIEW_IDS=
# For local testing only: make every active system view available. Leave false otherwise.
# DATAVERSE_ALLOW_ALL_SYSTEM_VIEWS=false
# How long view definitions are cached, in seconds. 0 turns caching off.
# DATAVERSE_VIEW_CACHE_TTL_SECONDS=60
